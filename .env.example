# 「回家照相馆」本地环境变量（复制为 .env）
# 清单与默认值以 docs/prd/spec/08-本地开发指南.md §4 为准；本文件不新增任何变量。

# ---- 数据与存储 ----
DATABASE_PATH=./data/app.db
STORAGE_DIR=./storage

# ---- 上游模型（Ark）----
# mock = fixture 回放（离线、可复现、自动检查的唯一判据）；real = 真实调用（手动冒烟）
PROVIDER=mock
# 仅 PROVIDER=real 时必填。绝不写入仓库。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-1-turbo-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
ARK_TIMEOUT_SECONDS=120

# ---- 短信验证码（本地替身）----
SMS_PROVIDER=console
DEV_LOGIN_CODE=000000

# ---- 实名核验（本地替身）----
ID_VERIFY_PROVIDER=local

# ---- 上传 ----
MAX_UPLOAD_MB=20

# ---- worker 与任务 ----
WORKER_STALE_MINUTES=10
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=120

# ---- 生成与合规 ----
GENERATION_DEFAULT_COUNT=2
WATERMARK_DEFAULT=false
AIGC_IMPLICIT_MARKER=true
